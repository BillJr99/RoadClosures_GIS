# Frontend configuration. Copy to `.env` (or `.env.production`) and adjust.
#
# Base URL of the backend API the frontend calls. This is baked in at BUILD time
# (Vite inlines import.meta.env during `npm run build`/`npm run dev`), so set it
# before building the bundle you deploy. Defaults to http://localhost:8001/api
# when unset.
#
# If you point this at a non-localhost backend, also set CORS_ALLOW_ORIGINS on the
# backend (see README) so the API accepts requests from the frontend's origin.
VITE_API_BASE=http://localhost:8001/api
